{
  "name": "tree-sitter-vbnet",
  "version": "0.2.0",
  "description": "Tree-sitter grammar for Visual Basic .NET",
  "main": "bindings/node",
  "types": "bindings/node",
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js",
    "check": "tree-sitter generate && node tools/node-kinds.mjs --check && node tools/parser-budget.mjs && npm run lint && npm run format:check && node --test tools/*.test.mjs && node tools/release-policy.mjs versions && tree-sitter test && node tools/fixture-check.mjs && gcc -std=c11 -Wall -Wextra -Wpedantic -Werror -O2 -c -Isrc src/scanner.c -o /dev/null && node tools/fuzz-check.mjs && cargo fmt --all --check && cargo clippy --all-targets -- -D warnings && cargo test && node tools/package-check.mjs && node-gyp rebuild && npm test",
    "lint": "oxlint grammar.js grammar tools bindings/node && tsc -p tsconfig.json",
    "format": "oxfmt grammar.js \"grammar/**/*.js\" \"tools/**/*.mjs\" \"bindings/node/*.js\" \"bindings/node/*.d.ts\"",
    "format:check": "oxfmt --check grammar.js \"grammar/**/*.js\" \"tools/**/*.mjs\" \"bindings/node/*.js\" \"bindings/node/*.d.ts\""
  },
  "author": "M. Reifschneider",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "node-addon-api": "^8.9.2",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "@types/node": "24.19.4",
    "node-gyp": "13.1.0",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "prebuildify": "6.0.1",
    "tree-sitter": "0.25.1",
    "tree-sitter-cli": "0.27.2",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "gypfile": true,
  "directories": {
    "test": "test"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alfpricot/tree-sitter-vbnet.git"
  },
  "bugs": {
    "url": "https://github.com/alfpricot/tree-sitter-vbnet/issues"
  },
  "homepage": "https://github.com/alfpricot/tree-sitter-vbnet#readme",
  "keywords": [
    "parser",
    "vbnet",
    "visual-basic",
    "tree-sitter"
  ],
  "files": [
    "grammar.js",
    "grammar/**",
    "binding.gyp",
    "bindings/node/binding.cc",
    "bindings/node/index.d.ts",
    "bindings/node/index.js",
    "queries/*",
    "src/**",
    "prebuilds/**",
    "tree-sitter.json",
    "NOTICE"
  ],
  "allowScripts": {
    "tree-sitter-cli@0.27.2": true,
    "tree-sitter@0.25.1": true
  }
}
